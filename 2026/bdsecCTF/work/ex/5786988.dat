<title>Billing Statement - Rahul Khan - City Medical Center</title>
<style>
  body { font-family: 'Times New Roman', Georgia, serif; background:#eef1f4; margin:0; color:#1a1a1a; }
  .sheet { max-width: 880px; margin: 20px auto; background:#fff; box-shadow:0 0 12px rgba(0,0,0,0.12); padding:0 0 30px; }
  .header { background:#7a1f2b; color:#fff; padding:20px 32px; }
  .header .hname { font-size:22px; font-weight:700; }
  .header .hsub { font-size:12px; color:#f0d6d6; margin-top:3px; }
  .header .haddr { font-size:11px; color:#f0d6d6; margin-top:2px; }
  .meta { padding: 18px 32px; border-bottom: 2px solid #7a1f2b; font-size:13px; }
  .meta table { width:100%; }
  .meta td { padding:3px 8px 3px 0; }
  .meta td.label { color:#555; width:150px; }
  .meta td.value { font-weight:700; }
  h2 { padding: 0 32px; color:#7a1f2b; font-size:16px; border-bottom:1px solid #ddd; padding-bottom:6px; margin-top:28px; }
  table.billing { width: calc(100% - 64px); margin: 0 32px; border-collapse:collapse; font-size:13px; }
  table.billing td { padding:6px 4px; border-bottom:1px solid #eee; }
  table.billing td.amt { text-align:right; font-variant-numeric: tabular-nums; }
  .total-row td { font-weight:800; border-top:2px solid #7a1f2b; }
  .summary { margin: 20px 32px; font-size:14px; }
  .summary table { width:100%; }
  .summary td { padding:5px 0; }
  .summary td.right { text-align:right; font-weight:700; }
  .denied { color:#7a1f2b; font-weight:800; }
  .urgent-box { margin: 26px 32px; border: 3px solid #b3261e; border-radius: 4px; padding: 18px 22px; background:#fff5f5; }
  .urgent-box h3 { color:#b3261e; margin:0 0 10px; font-size:16px; letter-spacing:0.5px; }
  .urgent-box p { margin: 6px 0; font-size:13.5px; line-height:1.5; }
  .signature-block { margin: 30px 32px 0; font-size:13px; }
  .signature-line { border-top:1px solid #333; width:260px; margin-top:40px; padding-top:6px; }
  .stamp { display:inline-block; border:2px solid #7a1f2b; color:#7a1f2b; padding:8px 14px; transform:rotate(-6deg); font-weight:800; font-size:12px; letter-spacing:1px; margin-top:14px; }
  .footer-note { padding: 20px 32px 0; font-size:10.5px; color:#888; }
</style>
</head>
