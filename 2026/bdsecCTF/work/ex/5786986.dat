<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Account Statement - Arif Khan - CityTrust Bank</title>
<style>
  body { font-family: Arial, Helvetica, sans-serif; background:#f4f6f8; margin:0; color:#1a1a1a; }
  .sheet { max-width: 960px; margin: 20px auto; background:#fff; box-shadow:0 0 12px rgba(0,0,0,0.12); }
  .letterhead { background:#0b3d63; color:#fff; padding:24px 32px; display:flex; justify-content:space-between; align-items:center; }
  .letterhead .bankname { font-size:24px; font-weight:700; letter-spacing:0.5px; }
  .letterhead .tagline { font-size:11px; color:#bcd4e6; margin-top:4px; }
  .letterhead .stamp { text-align:right; font-size:11px; color:#bcd4e6; }
  .meta { padding: 20px 32px; border-bottom: 2px solid #0b3d63; }
  .meta table { width:100%; font-size:13px; }
  .meta td { padding:3px 0; }
  .meta td.label { color:#666; width:180px; }
  .meta td.value { font-weight:600; }
  .txn-table { width:100%; border-collapse:collapse; font-size:12.5px; }
  .txn-table th { background:#eef2f6; text-align:left; padding:8px 10px; border-bottom:2px solid #0b3d63; position:sticky; top:0; }
  .txn-table td { padding:7px 10px; border-bottom:1px solid #e4e8ec; vertical-align:top; }
  .txn-table td.credit-col, .txn-table td.debit-col, .txn-table td.balance { text-align:right; white-space:nowrap; font-variant-numeric: tabular-nums; }
  .credit td.credit-col { color:#0a7a2f; font-weight:600; }
  .debit td.debit-col { color:#b3261e; font-weight:600; }
  .debit.failed td.debit-col { color:#b3261e; font-weight:600; opacity:0.75; }
  .balance.negative { color:#b3261e; font-weight:700; }
  .tag-failed { background:#fdecea; color:#b3261e; font-size:10px; padding:1px 5px; border-radius:3px; margin-left:4px; }
  .bdt { font-size:10.5px; color:#8a8a8a; }
  .opening-row td { background:#f4f6f8; font-weight:700; }
  .summary-box { margin: 24px 32px; border: 2px solid #0b3d63; border-radius: 6px; padding: 18px 24px; background:#f7fafc; }
  .summary-box h3 { margin-top:0; color:#0b3d63; }
  .summary-box table { width:100%; font-size:13.5px; }
  .summary-box td { padding:4px 0; }
  .summary-box td.right { text-align:right; font-weight:700; }
  .status-overdrawn { color:#b3261e; font-weight:800; }
  .footer-note { padding: 16px 32px 28px; font-size:11px; color:#888; }
  @media print { body { background:#fff; } .sheet { box-shadow:none; margin:0; } }
</style>
</head>
