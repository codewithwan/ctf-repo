#!/bin/busybox sh
export PATH=/bin
/bin/busybox mkdir -p /proc /sys /dev /etc /usr/lib /run
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev

trial() {
  echo "########## TRIAL: $1"
  printf 'testinput\n' | /io_hrana.elf 2>&1
  echo "----- exit=$?"
}

cat > /etc/os-release <<'OSR'
NAME="Debian GNU/Linux"
ID=debian
ID_LIKE=debian
PRETTY_NAME="Debian GNU/Linux 12 (bookworm)"
VERSION_ID="12"
VERSION="12 (bookworm)"
VERSION_CODENAME=bookworm
BUILD_ID=12
IMAGE_ID=debian
IMAGE_VERSION=12
VARIANT_ID=server
HOME_URL="https://www.debian.org/"
OSR
cp /etc/os-release /usr/lib/os-release
echo "0123456789abcdef0123456789abcdef" > /etc/machine-id
echo "debianhost" > /etc/hostname
echo "12.5" > /etc/debian_version
trial "comprehensive debian env"

# show what DMI qemu exposes (for anti-VM ID hypotheses)
echo "########## DMI dump"
for f in /sys/class/dmi/id/*; do
  [ -f "$f" ] && echo "$f = $(/bin/busybox cat "$f" 2>/dev/null)"
done
echo "########## /proc/sys/kernel"
/bin/busybox cat /proc/sys/kernel/osrelease 2>/dev/null
/bin/busybox cat /proc/version 2>/dev/null

/bin/busybox poweroff -f
